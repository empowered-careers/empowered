# =============================================================================
# Empowered Careers — environment variables
# =============================================================================
#
# Copy to .env.local and fill in. Validated by the Zod schema in `env.ts` at
# startup, so a bad value fails the boot with a readable error.
#
# DESIGN NOTE — most integrations are optional and INERT when unset. Without
# STRIPE_SECRET_KEY the app boots normally, Checkout just can't run. Without
# LOOPS_API_KEY, lifecycle events are a no-op. Without a webhook secret, that
# webhook route returns 503 and the events aren't recorded. This is deliberate
# so the app runs locally without every vendor provisioned — do not "fix" it by
# making these required in env.ts.
#
# Only NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are
# required to boot. Anything marked REQUIRED below is required for that
# subsystem to function, not for the process to start.
#
# Service-by-service setup instructions: docs/handover/services.md
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — auth, PostgreSQL, storage, realtime
# Dashboard: https://supabase.com/dashboard/project/wpurdayfjsyiedabmipt
# Get keys:  Project Settings → API Keys
# -----------------------------------------------------------------------------

# REQUIRED to boot. Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# REQUIRED to boot. The publishable (formerly "anon") key. Safe in the browser;
# RLS is what protects the data. See MIGRATION.md for the anon → publishable
# key change.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# REQUIRED for background jobs. The secret (formerly "service_role") key —
# bypasses RLS. Server-side only, never expose to the browser. Inngest workers
# use this to write parse/score results back.
SUPABASE_SECRET_KEY=

# Convenience only — the project ref, used by the Supabase CLI. Not read by
# env.ts.
NEXT_PUBLIC_SUPABASE_PROJECT_ID=


# -----------------------------------------------------------------------------
# App / SEO
# -----------------------------------------------------------------------------

# The canonical public URL. Everything derives from it: OAuth callback redirect,
# Stripe Checkout success/cancel URLs, sitemap, llms.txt, JSON-LD, canonicals,
# OG images.
#
# LOCAL:      http://localhost:3000
# PRODUCTION: must be set on the deploy host, or Stripe Checkout sends people
#             back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Used only to build the employer-invite redirect in
# src/app/actions/admin.ts. Set it to the same value as NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_APP_URL=

# Optional. Leftover from the starter template — read by env.ts but not used
# anywhere in the app. src/config/site.ts holds the real branding.
# NEXT_PUBLIC_APP_NAME=

# Optional. Google Search Console verification token. When set, it's emitted as
# a meta tag in the root layout. Needed to verify the site and submit the
# sitemap.
# Dashboard: https://search.google.com/search-console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# -----------------------------------------------------------------------------
# Anthropic — resume/LinkedIn parsing, ATS scoring, Big Wins bullet rewrites
# Dashboard: https://console.anthropic.com
# Get key:   Settings → API Keys
# -----------------------------------------------------------------------------

# REQUIRED for the resume pipeline. Without it, every parse and score run fails
# at getAnthropic(). Server-side only.
#
# MUST ALSO BE SET IN VERCEL. Inngest Cloud runs the workers by calling the
# Vercel function, so a local-only key means every production run fails.
ANTHROPIC_API_KEY=

# Optional overrides. Defaults shown. Cheap model for extraction, stronger model
# for scoring. Changing these invalidates your eval baselines.
# ANTHROPIC_PARSER_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_SCORER_MODEL=claude-sonnet-4-6

# Optional. Bump when you change prompts or the scoring rubric — stamped onto
# each resumes/linkedin_profiles row so you can tell which prompt produced a
# given result.
# RESUME_PROMPT_VERSION=1.1.0
# LINKEDIN_PROMPT_VERSION=1.1.0


# -----------------------------------------------------------------------------
# Inngest — background job orchestration
# Dashboard: https://app.inngest.com   (app id: empowered-careers)
# Get keys:  the app's Manage → Keys page
# -----------------------------------------------------------------------------
#
# LOCAL DEV NEEDS NEITHER OF THESE. `npm run dev` sets INNGEST_DEV=1, which
# points the client at the local dev server (`npm run inngest:dev`, GUI on
# http://localhost:8288).
#
# PRODUCTION NEEDS BOTH, and they are two different keys:
#   - SIGNING key  = Inngest Cloud proving it may invoke your endpoint
#   - EVENT key    = your app proving it may send events
# Only having the signing key means inngest.send() throws and submitJd records
# `inngest_send_failed`.

# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=


# -----------------------------------------------------------------------------
# Stripe — one-time à la carte purchases (NOT subscriptions)
# Dashboard: https://dashboard.stripe.com
# Get keys:  Developers → API keys
# -----------------------------------------------------------------------------
#
# The product catalog lives in the Stripe Dashboard; price IDs are pasted into
# coaching_products.stripe_price_id via /admin/coaching. See
# docs/ec-catalog-setup.md.
#
# Use test-mode keys (sk_test_… / pk_test_…) locally. Test card: 4242 4242 4242 4242.

# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# The webhook signing secret. Locally, get it from `stripe listen --forward-to
# localhost:3000/api/stripe/webhook`. In production it comes from the webhook
# endpoint you create in the Dashboard. Without it the webhook route can't
# verify signatures — so no payments or enrollments are ever recorded.
# STRIPE_WEBHOOK_SECRET=whsec_...

# DORMANT — subscription tier price IDs (Core = plan_2, Pro = plan_3, monthly
# and quarterly). Subscriptions were removed in the coaching pivot; these are
# frozen, not extended. Leave unset. See CLAUDE.md rule 2.
# STRIPE_PRICE_CORE_MONTHLY=
# STRIPE_PRICE_CORE_QUARTERLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_QUARTERLY=


# -----------------------------------------------------------------------------
# Purchase gate
# -----------------------------------------------------------------------------
#
# When exactly "true", a signed-in candidate needs an enrollment — i.e. a
# completed Stripe purchase — to reach the app. Any other value (including
# unset) is fully inert: no behavior change anywhere.
#
# Entitlement is read from the `enrollments` table, never from user metadata
# (the browser session can write that itself). Admins always bypass.
#
# See src/lib/purchase-gate.ts.
# PURCHASE_GATE_ENABLED=false

# The private beta invite code (e.g. ECTEST100). There are two ways a tester
# gets in, and both end at the same place — an `enrollments` row:
#
#   1. Enter the code at /invite. `redeemInviteCode()` grants a comp
#      "Beta Access" enrollment, written on the SERVICE-ROLE client because
#      candidates have no INSERT policy on `enrollments`.
#   2. Run real Stripe checkout using the same string as a 100%-off promotion
#      code. That produces a completed session, and the webhook grants the
#      enrollment.
#
# Matching is case- and whitespace-insensitive (testers paste it out of an
# email) and never matches when this is unset or blank — so a blank form can't
# unlock anything, and /invite hides the form entirely, falling back to the
# purchase route.
# BETA_INVITE_CODE=


# -----------------------------------------------------------------------------
# Loops — transactional email + lifecycle sequences
# Dashboard: https://app.loops.so
# Get key:   Settings → API
# -----------------------------------------------------------------------------
#
# WIRED BUT NOT YET LIVE. The app fires seven candidate.* events already, but
# no sequences exist in Loops to receive them, so nothing sends. When the key is
# unset, event firing is a no-op — local registration still works.
# See docs/ec-admin-operations.md and docs/handover/open-items.md.
# LOOPS_API_KEY=


# -----------------------------------------------------------------------------
# Booking webhooks
# -----------------------------------------------------------------------------
#
# Calendly is the live provider. Cal.com is a built-but-unused twin — same
# shape, no account behind it. When a secret is unset, that route returns 503
# and bookings simply aren't recorded into coaching_sessions.
#
# Calendly setup: subscribe a webhook to invitee created / rescheduled /
# cancelled, pointing at https://<domain>/api/calendly/webhook. All session
# products deliberately share one Calendly event type — bookings are matched on
# `utm_content` (the enrollment id), not the slug.
# Dashboard: https://calendly.com/integrations/api_webhooks
# CALENDLY_WEBHOOK_SECRET=

# Cal.com — DORMANT. https://app.cal.com/settings/developer/webhooks
# CAL_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Node
# -----------------------------------------------------------------------------
# Set automatically by Next.js. Don't set it by hand.
# NODE_ENV=development
